from pathlib import Path

class ParagraphAnchor:
    @property
    def anchor_id(self) -> str: ...
    @property
    def ordinal(self) -> int: ...
    @property
    def start_byte(self) -> int: ...
    @property
    def end_byte(self) -> int: ...
    @property
    def start_char(self) -> int: ...
    @property
    def end_char(self) -> int: ...
    @property
    def text(self) -> str: ...

class PreparedText:
    @property
    def text(self) -> str: ...
    @property
    def digest(self) -> str: ...
    @property
    def paragraphs(self) -> list[ParagraphAnchor]: ...

class StoredObject:
    @property
    def digest(self) -> str: ...
    @property
    def relative_path(self) -> str: ...
    @property
    def size(self) -> int: ...
    @property
    def created(self) -> bool: ...

def prepare(text: str) -> PreparedText: ...
def put_object(object_root: Path, data: bytes) -> StoredObject: ...
def semantic_analyze(
    texts: list[str], near_duplicate_threshold: float
) -> list[
    tuple[
        list[str],
        int,
        int,
        int,
        int,
        str,
        int | None,
        list[int],
    ]
]: ...
def bm25_rank(
    documents: list[list[str]],
    query: list[str],
    k1: float = ...,
    b: float = ...,
) -> list[tuple[int, float]]: ...
def coverage_intervals(
    text: str, ranges: list[tuple[int, int]]
) -> tuple[list[tuple[int, int]], int]: ...
